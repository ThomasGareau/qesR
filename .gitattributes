# Shipped tables are UTF-8 with LF endings on every platform: their md5 is
# recorded in inst/extdata/VERSIONS (design.md sections 3.1 and 5.1).
*.csv text eol=lf
inst/extdata/VERSIONS text eol=lf
inst/CITATION text eol=lf
inst/extdata/harmonize/** text eol=lf
*.sav binary
# Build-input snapshots are compared by md5 (data-raw/inputs/dataverse/index.csv):
# never convert their line endings.
data-raw/inputs/** -text
