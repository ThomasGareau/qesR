tryCatch(
  get_qes("QES 2022"),
  qesR_error_unknown_study = function(e) e$suggestions
)
options(old)

# the synthetic demonstration study ships with qesR: no download
demo <- get_qes("qes_demo", quiet = TRUE)
qes_provenance(demo)
