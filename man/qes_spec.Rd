xw[, c("study", "source_var", "grade", "levels_not_offered")]
xw # prints the target's section of the reference

# code by code, in French
qes_spec("crosswalk", targets = "sov_indep", studies = "qes2014",
         level = "code", lang = "fr")

# the checked spec itself
s <- qes_spec("spec")
s
}
